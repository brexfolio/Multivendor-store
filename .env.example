# ============================================================
# Telegram
# ============================================================

# Bot token from @BotFather. Server-only — never expose to the browser.
TELEGRAM_BOT_TOKEN=

# The public channel the bot auto-posts new products to.
# The bot must be added to this channel as an admin with post permissions.
# Example: @my_electronics_store
TELEGRAM_CHANNEL_ID=

# Numeric Telegram user ID of the store owner/admin. Only this user
# can access the Admin Dashboard. Find yours via @userinfobot.
ADMIN_TELEGRAM_ID=

# Random secret string used to verify that webhook requests really
# come from Telegram (sent back as X-Telegram-Bot-Api-Secret-Token).
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional — enables direct "open the Mini App" deep links (t.me/<bot>/<app>?startapp=...)
# on the channel's "View Product" button and the bot's /start message.
# Set these to your bot's @username and the Mini App short name from BotFather's /newapp.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_APP_NAME=

# ============================================================
# App
# ============================================================

# Public URL this app is deployed at (no trailing slash).
# Example: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=

# ============================================================
# Supabase
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
